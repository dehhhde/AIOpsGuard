# 应用配置
APP_NAME="AIOps Diagnosis Agent"
APP_VERSION="0.1.0"
DEBUG=false

# 测试模式（使用 Mock 数据，无需外部依赖）
TEST_MODE=true

# 数据库配置
DATABASE_ENABLED=false
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/aiops_agent
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false

# Redis 配置
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_MAX_CONNECTIONS=50

# Prometheus 配置
PROMETHEUS_ENABLED=true
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_TIMEOUT=30

# Loki 配置
LOKI_ENABLED=false
LOKI_URL=http://localhost:3100
LOKI_TIMEOUT=30

# Tempo 配置
TEMPO_ENABLED=false
TEMPO_URL=http://localhost:3200
TEMPO_TIMEOUT=30

# Kafka 配置
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_GROUP_ID=aiops-agent

# LLM 配置
LLM_ENABLED=false
LLM_PROVIDER=openai  # openai / ollama / qwen / deepseek
LLM_API_KEY=sk-xxx
LLM_BASE_URL=  # Ollama: http://localhost:11434/v1
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=60.0

# JWT 配置
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json  # json, text
